# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


*.keystore
*.jks
# Playwright test output/artifacts
test-results/

# apps/rn (Expo React Native app — migration Track B)
apps/rn/node_modules/
apps/rn/.expo/
.expo/
apps/rn/dist/
apps/rn/web-build/
apps/rn/expo-env.d.ts
# ./core is an auto-created link to ../../packages/core (see apps/rn/metro.config.js) — never commit it
apps/rn/core
apps/rn/dist-embed/

# ⛔ test:gate-plants writes these INTO scripts/ while it runs and removes them after (S1.10.6.1).
# A `git add -A` that races the gate commits them. They are transient by construction — never tracked.
scripts/__gate_plant_*

# ⛔ prove:guards writes the registry temp-then-rename (S1.13.7.12.3a), so a hard kill between the two
# can leave this behind. The catch removes it; this is the backstop, since an untracked file beside the
# registry is exactly what a `git add -A` would commit.
scripts/*.json.tmp
