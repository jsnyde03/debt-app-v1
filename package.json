{
  "name": "debt-app-v1",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve:export": "serve out",
    "lint": "eslint && npm run lint:webkit",
    "lint:webkit": "tsx scripts/check-webkit-flex-controls.ts",
    "lint:a11y-props": "tsx scripts/check-native-a11y-props.ts",
    "lint:comments": "tsx scripts/check-comment-convention.ts",
    "lint:rn-style": "tsx scripts/check-rn-style-divergence.ts",
    "lint:local-dates": "tsx scripts/check-local-dates.ts",
    "test:e2e": "playwright test",
    "test:e2e:rn": "playwright test --config apps/rn/playwright.config.ts",
    "shots:demo": "playwright test --config apps/rn/playwright.shots.config.ts",
    "e2e:fresh": "node scripts/e2e-fresh.cjs",
    "e2e:fresh:rn": "node scripts/e2e-fresh-rn.cjs",
    "test:app": "npm --prefix apps/rn run test:app",
    "test:scenarios": "npm --prefix apps/rn run test:scenarios",
    "test:all": "npm run test:regression && npm run test:app && npm run test:scenarios",
    "lint:copy": "tsx scripts/strings-inventory.ts --gate",
    "lint:glossary": "tsx scripts/check-glossary.ts",
    "lint:money": "tsx scripts/check-money-format.ts",
    "lint:closure": "tsx scripts/check-audit-closure.ts",
    "lint:apostrophes": "tsx scripts/check-apostrophes.ts",
    "lint:destructive": "tsx scripts/check-destructive-writes.ts",
    "lint:secrets": "tsx scripts/check-committed-secrets.ts",
    "lint:selectors": "tsx scripts/check-maestro-selectors.ts",
    "lint:coverage": "tsx scripts/coverage-split.ts --gate",
    "lint:a11y-collapse": "tsx scripts/check-a11y-collapse.ts",
    "lint:lane": "tsx scripts/preflight-native-lane.ts",
    "lint:rn": "npm --prefix apps/rn run lint && npm run lint:a11y-props && npm run lint:comments && npm run lint:rn-style && npm run lint:local-dates && npm run lint:copy && npm run lint:glossary && npm run lint:money && npm run lint:apostrophes && npm run lint:closure && npm run lint:destructive && npm run lint:secrets && npm run lint:selectors && npm run lint:coverage && npm run lint:a11y-collapse && npm run lint:lane",
    "typecheck:rn": "npm --prefix apps/rn run typecheck",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck": "npm run typecheck:core && npm run typecheck:rn",
    "validate:release:rn": "npm run typecheck && npm run lint:rn && npm run test:stamp && npm run test:regression && npm run test:app && npm run test:scenarios && npm run test:e2e:rn && npm run test:e2e:embed",
    "validate:release": "npm run validate:release:rn",
    "validate:release:legacy": "npm run lint && npm run test:regression && npm run test:app && npm run test:e2e",
    "audit:strings": "tsx scripts/strings-inventory.ts",
    "audit:surfaces": "tsx scripts/surface-inventory.ts",
    "audit:coverage": "tsx scripts/coverage-split.ts",
    "stamp:coverage": "tsx scripts/stamp-coverage.ts",
    "test:stamp": "tsx scripts/test-stamp-coverage.ts",
    "preflight:xcuitest": "tsx scripts/preflight-xcuitest-target.ts",
    "test:regression": "tsx packages/core/testing/runRegressionTests",
    "test:e2e:embed": "playwright test --config apps/rn/playwright.embed.config.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^13.1.5",
    "expo": "^56.0.9",
    "lucide-react": "^1.21.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/gensync": "^1.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "yaml": "^2.9.0"
  }
}
