{
  "expo": {
    "name": "Debt Planner (RN)",
    "version": "2.0.0",
    "slug": "debt-planner-rn",
    "scheme": "debtplannerrn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.jasonsnyder.debtplanner",
      "appleTeamId": "CVCY985YCD",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Debt Planner",
        "ITSAppUsesNonExemptEncryption": false,
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Debt Plan"
          },
          {
            "INAlternativeAppName": "My Debt Planner"
          }
        ],
        "NSCameraUsageDescription": "Scan a statement or bill to prefill your debt details — the scan stays on your device."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jasonsnyder.debtplanner"
        ],
        "com.apple.developer.siri": true
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0a051c",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Debt Planner with Face ID."
        }
      ],
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerIdentifier": "iCloud.com.jasonsnyder.debtplanner",
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@bacons/apple-targets",
      "@sentry/react-native",
      "./plugins/with-local-notifications-only.js",
      "./plugins/with-context-menu-folly-fix.js",
      "./plugins/with-ios-utilities-rootcontentview-fix.js",
      "./plugins/with-live-activities.js",
      "./plugins/with-app-intents.js",
      "./plugins/with-xcuitest-target.js",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ]
  }
}
