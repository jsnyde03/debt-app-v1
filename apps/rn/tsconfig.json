{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@core/*": ["./core/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Exclude ./core (the packages/core link): the shared core is typechecked by the
  // Capacitor app, where its interim @/lib backward-deps resolve. apps/rn still
  // typechecks its OWN use of @core imports (e.g. App.tsx's calls) via the path alias.
  "exclude": ["core", "node_modules", "dist", ".expo"]
}
