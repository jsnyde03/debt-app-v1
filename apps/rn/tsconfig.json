{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The `*.test.ts` files are node scripts run by tsx, not RN modules — `tutorialPath.test.ts` reads
    // source files off disk to assert the arc, so it needs `node:fs`, `node:path` and `__dirname`.
    // Without this `npm run typecheck` was red on master with 3 errors, which is the worst state for a
    // gate to be in: a permanently-failing check trains everyone to skip reading its output, and a real
    // regression hides in the noise. Expo's base config leaves `types` unset for RN, so name it here.
    "types": ["node"],
    "paths": {
      "@core/*": ["./core/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Exclude ./core (the packages/core link): the shared core is typechecked by the
  // Capacitor app, where its interim @/lib backward-deps resolve. apps/rn typechecks
  // its OWN @core + @/ usage via the path aliases above.
  // Exclude the Playwright e2e harness (config + specs): it's node/@playwright code that Playwright
  // compiles itself (own tsconfig + node globals), not part of the RN app's type surface.
  "exclude": ["core", "node_modules", "dist", ".expo", "playwright.config.ts", "tests"]
}
